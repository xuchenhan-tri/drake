<?xml version="1.0"?>
<sdf version="1.7">
  <model name="simple_gripper">
    <pose>0 0 0 0 0 0</pose>
    <joint name="translate_joint" type="prismatic">
      <parent>world</parent>
      <child>body</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
      <drake:controller_gains p='100000.0' d='1.0' />
    </joint>
    <link name="body">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>20</mass>
        <inertia>
          <!-- 1/6 m * l^2 -->
          <ixx>0.1333333</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1333333</iyy>
          <iyz>0</iyz>
          <izz>0.1333333</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.2 0.2 0.2</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.3 0.3 0.3 0.9</diffuse>
        </material>
      </visual>
    </link>
    <link name="gripper">
      <pose>0 0 -0.2 0 0 0</pose>
      <inertial>
        <mass>20</mass>
        <inertia>
          <!-- 1/6 m * l^2 -->
          <ixx>0.1333333</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1333333</iyy>
          <iyz>0</iyz>
          <izz>0.1333333</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.2 0.2 0.2</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.6 0.3 0.3 0.9</diffuse>
        </material>
      </visual>
    </link>
    <joint name="weld" type="fixed">
      <child>gripper</child>
      <parent>body</parent>
    </joint>
  </model>
</sdf>
